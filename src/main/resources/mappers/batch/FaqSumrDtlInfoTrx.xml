<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plateer.aifaq.bo.mapper.FaqSumrDtlInfoMapper">
    <insert id="insert" parameterType="FaqSumrDtlDto">
        insert into faq_sumr_dtl_info(faq_id, quest_cont, ans_cont, disp_yn)
        values
            <foreach collection="list" item="item" separator=",">
                (#{item.faqId}, #{item.questCont}, #{item.ansCont}, #{item.dispYn})
            </foreach>
    </insert>
</mapper>