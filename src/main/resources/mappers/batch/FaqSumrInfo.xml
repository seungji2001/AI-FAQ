<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plateer.aifaq.bo.mapper.FaqSumrInfoMapper">
    <select id="findByLinkStatus" parameterType="String" resultType="FaqSumrDto">
        SELECT *
        FROM FAQ_SUMR_INFO
        WHERE LINK_STATUS = #{linkStatus}
    </select>
</mapper>