<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plateer.aifaq.bo.mapper.LiveStrtEndMapper">

    <resultMap id="LiveStrtEndResultMap" type="LiveStrtEndDto">
        <id property="id" column="id"/>
        <result property="goodsId" column="goods_id"/>
        <result property="pgmId" column="pgm_id"/>
        <result property="strtDt" column="start_date"/>
        <result property="endDt" column="end_date"/>
        <result property="seq" column="seq"/>
    </resultMap>

    <select id="maxSeqGroupByPgmId" parameterType="Long" resultType="Integer">
        SELECT MAX(SEQ)
        FROM LIVE_START_END
        GROUP BY PGM_ID
        HAVING PGM_ID = #{pgmId}
    </select>

    <select id="findLiveStrtEndsByPgmId" parameterType="Long" resultMap="LiveStrtEndResultMap">
        SELECT *
        FROM LIVE_START_END
        WHERE 1 = 1
            AND PGM_ID = #{pgmId}
    </select>

    <select id="findLiveStrtEndsEndDateIsNull" resultType="Integer">
        SELECT count(*)
        FROM LIVE_START_END
        WHERE END_DATE IS NULL
    </select>

    <select id="findMstGoodsByPgmId" resultMap="LiveStrtEndResultMap" parameterType="Long">
        SELECT *
        FROM (SELECT
                ID,
                PGM_ID,
                GOODS_ID,
                ROW_NUMBER() OVER (PARTITION BY SEQ ORDER BY GOODS_ID) AS RNK,
                START_DATE,
                END_DATE
              FROM LIVE_START_END
              WHERE PGM_ID = #{pgmId}) MST_GOODS
        WHERE 1 = 1
            AND MST_GOODS.RNK = 1
            AND NOT EXISTS (
                SELECT 1
                FROM faq_sumr_info fsi
                WHERE fsi.live_start_end_id = mst_goods.id
            )
    </select>

    <select id="findCurrentPgm" resultType="Long">
        SELECT PGM_ID
        FROM LIVE_START_END
        WHERE END_DATE IS NULL
        LIMIT 1
    </select>
</mapper>